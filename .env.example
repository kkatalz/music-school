# ---------------------------------------------------------------------------
# Read by docker-compose (it only ever looks for .env next to the compose file)
# and by backend/src/ormconfig.ts when you run migrations/seeds from the host.
# ---------------------------------------------------------------------------

# --- Postgres container ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=music_school
# Host port. The container always listens on 5432 internally.
POSTGRES_PORT=5400

# --- Backend ---
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
# Host-side connection string (migrations, seed, `npm run start:dev` outside docker).
# Inside docker-compose the api service overrides this with the `db` hostname.
DATABASE_URL=postgres://postgres:postgres@localhost:5400/music_school

# --- Frontend ---
FRONTEND_PORT=5173
